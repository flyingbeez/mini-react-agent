# 复制为 .env 并填入自己的 Key（.env 已被 .gitignore 忽略，不会提交）
#
# 本项目不强制依赖任何环境变量：不配也能跑 examples/01_offline_demo.py 和 run_tests.py。

# DeepSeek（推荐：便宜、中文好、OpenAI 兼容）
DEEPSEEK_API_KEY=sk-your-key-here

# 其他任何 OpenAI 兼容服务（OpenAI / 通义千问 / 智谱 / Moonshot / vLLM / Ollama）
# LLM_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Agent 运行模式：native（原生 function calling）或 text（文本 ReAct）
AGENT_MODE=native
